    "@peculiar/asn1-rsa": "^2.0.44",
    "@peculiar/asn1-schema": "^2.0.44",
    "@peculiar/jose": "^1.8.2",
    "pvtsutils": "^1.2.1",
    "reflect-metadata": "^0.1.13",
    "tsyringe": "^4.6.0"
