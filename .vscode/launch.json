{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Tests",
      "type": "node",
      "request": "launch",
      "program": "${workspaceRoot}/node_modules/vitest/vitest.mjs",
      "args": [
        "run",
        "--no-file-parallelism",
        "--test-timeout=0",
        "--hook-timeout=0"
      ],
      "env": {
        "NODE_TLS_REJECT_UNAUTHORIZED": "0"
      },
      "cwd": "${workspaceRoot}",
      "internalConsoleOptions": "openOnSessionStart"
    }
  ]
}
