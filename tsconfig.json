{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "DOM"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "noImplicitOverride": true,
    "noErrorTruncation": true,
    "noEmit": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "paths": {
      "@peculiar/acme-client": ["./packages/client/src"],
      "@peculiar/acme-core": ["./packages/core/src"],
      "@peculiar/acme-data": ["./packages/data/src"],
      "@peculiar/acme-data-dynamodb": ["./packages/data-dynamodb/src"],
      "@peculiar/acme-data-memory": ["./packages/data-memory/src"],
      "@peculiar/acme-express": ["./packages/server-express/src"],
      "@peculiar/acme-protocol": ["./packages/protocol/src"],
      "@peculiar/acme-ra": ["./packages/server-ra/src"],
      "@peculiar/acme-server": ["./packages/server/src"],
      "@peculiar/acme-test-server": ["./packages/test-server/src"],
      "@peculiar/jose": ["./packages/jose/src"]
    }
  },
  "include": ["packages/*/src", "*.config.ts"]
}
